; Recursive Fibonacci in the project ISA
; Conventions:
;   D1 = input n
;   D0 = return value
;   port 0 = console output
;
; Opcode map used here:
;   01 MOV, 02 ADD, 03 SUB, 04 MUL, 05 DIV, 06 MOD
;   07 CMP, 08 JMP, 09 BEQ, 0A BLT, 0B BGT
;   0C CALL, 0D RET, 0E PUSH, 0F POP
;   11 OUT

; main
0100: 0x01020000  ; MOV #10, D1
0101: 0x2000000A
0102: 0x01000000

0103: 0x0C010000  ; CALL fib
0104: 0x5000010A

0105: 0x11020000  ; OUT D0, 0
0106: 0x00000000
0107: 0x20000000

0108: 0x08010000  ; JMP 0108 (halt loop)
0109: 0x50000108

; fib(n)
010A: 0x07020000  ; CMP D1, #2
010B: 0x01000000
010C: 0x20000002

010D: 0x0A010000  ; BLT fib_base
010E: 0x50000131

010F: 0x0E010000  ; PUSH D1
0110: 0x01000000

0111: 0x01020000  ; MOV D1, D2
0112: 0x01000000
0113: 0x02000000

0114: 0x03020000  ; SUB #1, D2
0115: 0x20000001
0116: 0x02000000

0117: 0x01020000  ; MOV D2, D1
0118: 0x02000000
0119: 0x01000000

011A: 0x0C010000  ; CALL fib
011B: 0x5000010A

011C: 0x0F010000  ; POP D1
011D: 0x01000000

011E: 0x0E010000  ; PUSH D0
011F: 0x00000000

0120: 0x01020000  ; MOV D1, D2
0121: 0x01000000
0122: 0x02000000

0123: 0x03020000  ; SUB #2, D2
0124: 0x20000002
0125: 0x02000000

0126: 0x01020000  ; MOV D2, D1
0127: 0x02000000
0128: 0x01000000

0129: 0x0C010000  ; CALL fib
012A: 0x5000010A

012B: 0x0F010000  ; POP D2
012C: 0x02000000

012D: 0x02020000  ; ADD D2, D0
012E: 0x02000000
012F: 0x00000000

0130: 0x0D000000  ; RET

; fib_base:
0131: 0x01020000  ; MOV D1, D0
0132: 0x01000000
0133: 0x00000000

0134: 0x0D000000  ; RET
