; Iterative factorial in the project ISA
; Conventions:
;   D0 = accumulator/result
;   D1 = loop counter / scratch
;   D2 = scratch
;   [0x0200] = result
;   [0x0201] = n
;   port 0 = console output
;
; Opcode map used here:
;   01 MOV, 02 ADD, 03 SUB, 04 MUL, 05 DIV, 06 MOD
;   07 CMP, 08 JMP, 09 BEQ, 0A BLT, 0B BGT
;   11 OUT

0100: 0x01020000  ; MOV #1, [0x0200]
0101: 0x20000001
0102: 0x50000200

0103: 0x01020000  ; MOV #5, [0x0201]
0104: 0x20000005
0105: 0x50000201

; loop:
0106: 0x07020000  ; CMP [0x0201], #0
0107: 0x50000201
0108: 0x20000000

0109: 0x0B010000  ; BGT body
010A: 0x5000010D

010B: 0x08010000  ; JMP end
010C: 0x50000121

; body:
010D: 0x01020000  ; MOV [0x0200], D0
010E: 0x50000200
010F: 0x00000000

0110: 0x04020000  ; MUL [0x0201], D0
0111: 0x50000201
0112: 0x00000000

0113: 0x01020000  ; MOV D0, [0x0200]
0114: 0x00000000
0115: 0x50000200

0116: 0x01020000  ; MOV [0x0201], D1
0117: 0x50000201
0118: 0x01000000

0119: 0x03020000  ; SUB #1, D1
011A: 0x20000001
011B: 0x01000000

011C: 0x01020000  ; MOV D1, [0x0201]
011D: 0x01000000
011E: 0x50000201

011F: 0x08010000  ; JMP loop
0120: 0x50000106

; end:
0121: 0x01020000  ; MOV [0x0200], D0
0122: 0x50000200
0123: 0x00000000

0124: 0x11020000  ; OUT D0, 0
0125: 0x00000000
0126: 0x20000000

0127: 0x08010000  ; JMP 0127 (halt loop)
0128: 0x50000127
